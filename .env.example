# Prisma Postgres 连接串（开发 / 生产同形）
# 本地 dev: postgresql://postgres:postgres@localhost:5432/exam
# Vercel Postgres: postgres://default:<password>@<host>-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb
DATABASE_URL=

# Auth.js v5 密钥（openssl rand -base64 32 生成）
AUTH_SECRET=

# 邮箱魔法链接 SMTP（Nodemailer）
# 形如：smtps://user:pass@smtp.example.com:465
EMAIL_SERVER=

# 发件人地址（必须被 SMTP 账号授权）
EMAIL_FROM=

# Auth.js 站点 URL（生产填 https://your-domain.vercel.app）
AUTH_URL=
