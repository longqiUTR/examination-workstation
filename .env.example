# ============================================================
# 考公工作台 v1 环境变量模板
# 本地开发：cp .env.example .env，然后填值
# 生产部署：在 Vercel 项目 Settings → Environment Variables 填，**不要** commit 真值
# ============================================================

# Prisma Postgres 连接串
# 本地 dev: postgresql://postgres:postgres@localhost:5432/exam
# Vercel Postgres: 复制 POSTGRES_PRISMA_URL 的值（pooler URL，连接池友好）
DATABASE_URL=

# Auth.js v5 密钥（openssl rand -base64 32 生成）
AUTH_SECRET=

# 邮箱魔法链接 SMTP（Nodemailer 字符串）
# 形如：smtps://user:pass@smtp.example.com:465
EMAIL_SERVER=

# 发件人地址（必须被 SMTP 账号授权）
EMAIL_FROM=

# [生产必填] Auth.js 站点 URL
# 本地：可留空（默认 http://localhost:3000）
# 生产：https://your-project.vercel.app（或自定义域名）
AUTH_URL=

# [生产可选] Prisma 加速：日志 / 调试
# NODE_ENV=production

